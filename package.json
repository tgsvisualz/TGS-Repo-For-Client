    "build:artifact": "vite build --mode artifact && node scripts/artifact-fragment.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
