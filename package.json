{
  "name": "velato-landing",
  "private": true,
  "version": "0.1.0",
  "description": "Velato stage-one landing prototype: veiled luxury womenswear with weekly drops.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
