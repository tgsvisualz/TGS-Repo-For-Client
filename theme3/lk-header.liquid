{%- liquid
  assign menu = linklists[section.settings.menu]
  assign home = false
  if template.name == 'index' or template.suffix contains 'campaign'
    assign home = true
  endif
-%}
<header class="hdr{% if home %} hdr--over{% endif %}" data-hdr>
  <div class="hdr__bar">
    <div class="hdr__left">
      <button type="button" class="hdr__btn" data-menu-open aria-expanded="false" aria-controls="lk-menu">{% render 'lk-t', k: 'menu' %} <span class="plus" aria-hidden="true">+</span></button>
      <a class="hdr__btn hide-sm" href="{{ routes.collections_url }}/new-drop">{% render 'lk-t', k: 's_new' %}</a>
      <a class="hdr__btn hide-sm" href="{{ routes.root_url }}#index">{% render 'lk-t', k: 's_index' %}</a>
    </div>
    <a class="hdr__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if section.settings.logo -%}
        {{ section.settings.logo | image_url: width: 480 | image_tag: alt: shop.name, widths: '160,240,320,480', sizes: '160px' }}
      {%- else -%}
        <span class="mark"><span class="mark__lk">LK</span><span class="mark__sub">{{ section.settings.wordmark | default: 'LK Fashion' | remove_first: 'LK ' }}</span></span>
      {%- endif -%}
    </a>
    <div class="hdr__right">
      <button type="button" class="hdr__btn hide-sm" data-search-open aria-controls="lk-search">{% render 'lk-t', k: 'search' %}</button>
      <span class="hide-sm hdr__loc">{% render 'lk-lang', compact: true %}{% render 'lk-cur' %}</span>
      <a class="hdr__btn" href="{{ routes.cart_url }}" data-cart-open>{% render 'lk-t', k: 'bag' %}<span class="hdr__count">.<span data-cart-count>{{ cart.item_count }}</span></span></a>
    </div>
  </div>
</header>

<div class="menu" id="lk-menu" data-menu aria-hidden="true" role="dialog" aria-modal="true" aria-label="{% render 'lk-t', k: 'menu' %}">
  <div class="menu__panel">
    <div class="menu__top">
      <button type="button" class="hdr__btn" data-menu-close>{% render 'lk-t', k: 'close' %} <span class="plus plus--x" aria-hidden="true">+</span></button>
      <div class="menu__loc">{% render 'lk-lang' %}{% render 'lk-cur' %}</div>
    </div>
    <nav class="menu__nav" aria-label="{% render 'lk-t', k: 'shop' %}">
      <ol class="menu__list" role="list">
        {%- for link in menu.links -%}
          {%- assign c = link.object -%}
          <li>
            <a href="{{ link.url }}" class="menu__link{% if link.active %} is-active{% endif %}"{% if c.featured_image or c.products.first.featured_image %} data-preview="{% if c.featured_image %}{{ c.featured_image | image_url: width: 1400 }}{% else %}{{ c.products.first.featured_image | image_url: width: 1400 }}{% endif %}"{% endif %}>
              <span class="menu__no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}.</span>
              <span class="menu__txt">{{ link.title }}</span>
              {%- if link.type == 'collection_link' -%}<span class="menu__count">[ {{ c.products_count }} ]</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ol>
    </nav>
    <div class="menu__aside" aria-hidden="true">
      <div class="menu__preview">
        {%- if images['lk-campaign.jpg'] -%}{{ images['lk-campaign.jpg'] | image_url: width: 3840 | image_tag: loading: 'lazy', widths: '1200,1600,2000,2400,3000,3840', sizes: '(max-width: 749px) 1px, 90vh', alt: '', class: 'menu__img', data-default: '' }}{%- endif -%}
      </div>
      <p class="mono">{% render 'lk-t', k: 'hero_side' %}</p>
    </div>
    <form class="menu__search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="menu-q">{% render 'lk-t', k: 'search' %}</label>
      <input id="menu-q" type="search" name="q" placeholder="{% render 'lk-t', k: 'search_placeholder' %}" autocomplete="off">
      <input type="hidden" name="type" value="product">
      <button class="mono" type="submit">[ {% render 'lk-t', k: 'search' %} ]</button>
    </form>
  </div>
</div>

<div class="srch" id="lk-search" data-search aria-hidden="true" role="dialog" aria-modal="true" aria-label="{% render 'lk-t', k: 'search' %}">
  <form class="srch__form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="srch-q">{% render 'lk-t', k: 'search' %}</label>
    <input id="srch-q" type="search" name="q" placeholder="{% render 'lk-t', k: 'search_placeholder' %}" autocomplete="off">
    <input type="hidden" name="type" value="product">
    <button class="mono" type="submit">[ {% render 'lk-t', k: 'search' %} ]</button>
    <button class="mono" type="button" data-search-close>[ {% render 'lk-t', k: 'close' %} ]</button>
  </form>
</div>

{% schema %}
{
  "name": "LK header",
  "class": "lk-hdr-wrap",
  "settings": [
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "LK Fashion" },
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Optional. Replaces the wordmark." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
