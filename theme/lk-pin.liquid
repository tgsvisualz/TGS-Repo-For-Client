{%- comment -%}
  Pinned scroll: the title ("Fashion that doesn't wait") drifts apart while two side images slide away and the campaign film grows to full bleed.
  JS sets --p (0 → 1) on [data-pin] as the section scrolls.
  Film: a looping video from Files when one is set; otherwise a coded loop (three frames cross-fading with a slow push-in:
  the three-women campaign, then a Black model, then a white model;
  crimson haze, film grain and flicker).
{%- endcomment -%}
{%- liquid
  assign img = section.settings.image
  if img == blank
    assign img = images['lk-campaign-4k.jpg']
  endif
  assign img_2 = section.settings.image_2
  if img_2 == blank
    assign img_2 = images['lk-film-1-4k.jpg']
  endif
  assign img_3 = section.settings.image_3
  if img_3 == blank
    assign img_3 = images['lk-film-2-4k.jpg']
  endif
  assign img_l = section.settings.image_left
  if img_l == blank
    assign img_l = images['lk-editorial.jpg']
  endif
  assign img_r = section.settings.image_right
  if img_r == blank
    assign img_r = images['lk-hero.jpg']
  endif
  assign link = section.settings.link
  if link == blank
    assign link = routes.collections_url | append: '/new-drop'
  endif
-%}
<section class="pin" data-pin aria-labelledby="pin-h-{{ section.id }}">
  <div class="pin__stick">
    <p class="mono pin__tl">({{ section.settings.number }}) {% render 'lk-t', k: 's_campaign' %}</p>
    <p class="mono pin__tr">{% render 'lk-t', k: 'campaign_tag' %}</p>
    <figure class="pin__side pin__side--l" aria-hidden="true">{%- if img_l -%}{{ img_l | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '22vw', alt: '' }}{%- endif -%}</figure>
    <figure class="pin__side pin__side--r" aria-hidden="true">{%- if img_r -%}{{ img_r | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '22vw', alt: '' }}{%- endif -%}</figure>
    <figure class="pin__main{% if section.settings.video == blank %} pin__main--loop{% endif %}">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1920x', class: 'pin__vid' }}
      {%- else -%}
        {%- assign alt = img.alt | default: '' -%}
        {%- for f in (1..3) -%}
          {%- liquid
            case f
              when 1
                assign fr_img = img
              when 2
                assign fr_img = img_2
              else
                assign fr_img = img_3
            endcase
          -%}
          {%- if fr_img -%}
            <span class="pin__f" style="--k:{{ forloop.index0 }}"{% if f > 1 %} aria-hidden="true"{% endif %}>{{ fr_img | image_url: width: 3840 | image_tag: loading: 'lazy', widths: '750,1100,1500,1920,2400,3000,3840', sizes: '(max-width: 749px) 390vw, 100vw', alt: alt }}</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      <span class="pin__haze" aria-hidden="true"></span>
      <span class="pin__grain" aria-hidden="true"></span>
    </figure>
    <h2 class="pin__word" id="pin-h-{{ section.id }}">
      <span class="pin__w pin__w--1">{% render 'lk-t', k: 'w1' %}</span><span class="pin__w pin__w--2">{% render 'lk-t', k: 'w2' %}</span><span class="pin__w pin__w--3">{% render 'lk-t', k: 'w3' %}</span>
    </h2>
    <div class="pin__end">
      <a class="bracket bracket--light" href="{{ link }}"><span>[</span> {% render 'lk-t', k: 'discover' %} <span>]</span></a>
    </div>
    <div class="pin__meter mono" aria-hidden="true"><span class="pin__meter-fill"></span></div>
  </div>
</section>

{% schema %}
{
  "name": "LK pinned film",
  "settings": [
    { "type": "text", "id": "number", "label": "Number", "default": "02" },
    { "type": "video", "id": "video", "label": "Loop video", "info": "Plays muted on a loop behind the title. Upload an MP4 (10–20 s, dark, slow) to Files. Blank = the coded film loop below." },
    { "type": "header", "content": "Film loop (when no video)" },
    { "type": "image_picker", "id": "image", "label": "Frame 1", "info": "Defaults to lk-campaign-4k.jpg from Files." },
    { "type": "image_picker", "id": "image_2", "label": "Frame 2", "info": "Defaults to lk-film-1-4k.jpg (Black model)." },
    { "type": "image_picker", "id": "image_3", "label": "Frame 3", "info": "Defaults to lk-film-2-4k.jpg (white model)." },
    { "type": "header", "content": "Side images" },
    { "type": "image_picker", "id": "image_left", "label": "Left image", "info": "Defaults to lk-editorial.jpg." },
    { "type": "image_picker", "id": "image_right", "label": "Right image", "info": "Defaults to lk-hero.jpg." },
    { "type": "url", "id": "link", "label": "Link", "info": "Blank = New Drop collection." }
  ],
  "presets": [{ "name": "LK pinned film" }]
}
{% endschema %}
