{%- liquid
  assign img = section.settings.image
  if img == blank
    assign img = images['lk-editorial.jpg']
  endif
-%}
<section class="sec mani" aria-labelledby="h-{{ section.id }}">
  {%- assign hid = 'h-' | append: section.id -%}
  {% render 'lk-shead', no: section.settings.number, k: 's_manifesto', id: hid %}
  <div class="mani__grid wrap">
    <figure class="mani__fig">
      {%- if img -%}
        {%- assign alt = img.alt | default: '' -%}
        {{ img | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200,1600,2000,2400', sizes: '(min-width: 990px) 42vw, 100vw', alt: alt, class: 'mani__img' }}
      {%- endif -%}
      <figcaption class="mono">(LK — {{ 'now' | date: '%Y' }})</figcaption>
    </figure>
    <ol class="mani__list" role="list">
      {%- for i in (1..3) -%}
        {%- capture kt -%}m{{ i }}_t{%- endcapture -%}{%- capture kk -%}m{{ i }}_k{%- endcapture -%}{%- capture kb -%}m{{ i }}_b{%- endcapture -%}
        <li class="mani__item" data-reveal>
          <h3 class="mani__t">{% render 'lk-t', k: kt %} <span class="mono mani__k">{% render 'lk-t', k: kk %}</span></h3>
          <p class="mani__b">{% render 'lk-t', k: kb %}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "LK manifesto",
  "settings": [
    { "type": "text", "id": "number", "label": "Number", "default": "04" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to lk-editorial.jpg from Files. Text lives in snippets/lk-t.liquid (EN + FR)." }
  ],
  "presets": [{ "name": "LK manifesto" }]
}
{% endschema %}
